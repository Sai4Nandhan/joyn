# JOYN Frontend Environment Variables
# Copy this file to .env for local development or configure in Vercel Environment Variables for production.

# Local Development:
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000

# Production (Vercel / Render):
# VITE_API_URL=https://joyn-backend.onrender.com/api
# VITE_SOCKET_URL=https://joyn-backend.onrender.com
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
