# JOYN Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Environment
# development | production
NODE_ENV=development

# Server port
PORT=5000

# MongoDB connection string
# Development: mongodb://localhost:27017/activity-platform
# Production: mongodb+srv://<user>:<password>@cluster.mongodb.net/activity-platform?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/activity-platform

# JWT Secrets — MUST be changed to long random strings in production (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_64_char_random_string_in_production
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change_this_to_a_different_64_char_random_string_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Authenticated Session Lifetime (in minutes, default: 30)
SESSION_DURATION_MINUTES=30

# Frontend URL — must match your deployed frontend domain for CORS
# Development: http://localhost:5173
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:5173

# Cookie security — MUST be true in production (requires HTTPS)
# Development: false
# Production: true
COOKIE_SECURE=false

# SMTP Mail Server Configuration (Gmail / SendGrid / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=JOYN App <your_email@gmail.com>

